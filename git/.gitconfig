[user]
	name = Mirko Zizzari
	email = mirkozizzari.mz@gmail.com
[core]
	autocrlf = input
[http]
	postBuffer = 524288000
[merge]
	tool = nvim
[diff]
	tool = nvim
[difftool "nvim"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\"
[mergetool "nvim"]
	cmd = nvim -d \"$LOCAL\" \"$BASE\" \"$REMOTE\" \"$MERGED\" -c \"autocmd VimEnter * 4wincmd w | wincmd J\"
[mergetool "intellij"]
	cmd = idea merge \"$LOCAL\" \"$REMOTE\" \"$BASE\" \"$MERGED\"
[mergetool]
	trustExitCode = false
[include]
	path = ~/.gitconfig.local
